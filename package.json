{
  "name": "la-compagnia-della-ghironda",
  "version": "1.1.0",
  "description": "La Compagnia della Ghironda - A medieval fantasy guild website",
  "homepage": "https://marco-onapex.github.io/La-Compagnia-della-Ghironda/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-onapex/La-Compagnia-della-Ghironda.git"
  },
  "bugs": {
    "url": "https://github.com/marco-onapex/La-Compagnia-della-Ghironda/issues"
  },
  "type": "module",
  "scripts": {
    "lint:html": "htmlhint index.html --config .htmlhintrc",
    "lint:css": "stylelint css/**/*.css",
    "lint:js": "node --disable-warning=ExperimentalWarning ./node_modules/eslint/bin/eslint.js . --max-warnings=0 --cache --cache-location=.eslintcache",
    "lint:docs": "node scripts/docs-lint.js",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run lint:docs",
    "lint:parallel": "npm-run-all --parallel lint:html lint:css lint:js lint:docs",
    "build:fonts": "node scripts/convert-fonts.js",
    "build:fonts:page": "node scripts/subset-fonts-page.js",
    "build:fonts:lcp": "node scripts/subset-fonts-lcp.js",
    "build": "cross-env NODE_ENV=production npm-run-all --parallel build:css build:js && npm run build:assets && cross-env NODE_ENV=production npm-run-all build:sitemap build:cache-bust build:csp && npm run build:strip && npm run size-report && npm run audit:performance && npm run docs:numbers",
    "build:strip": "node scripts/strip-html-comments.js",
    "build:assets": "node scripts/copy-static-assets.js",
    "docs:numbers": "node scripts/inject-doc-numbers.js",
    "docs:numbers:check": "node scripts/inject-doc-numbers.js --check",
    "build:cache-bust": "node scripts/cache-bust.js",
    "build:csp": "cross-env NODE_ENV=production node scripts/generate-csp.js",
    "build:css": "node build-css.js",
    "build:js": "cross-env NODE_ENV=production node build-js.js",
    "build:sitemap": "node scripts/update-sitemap.js",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,md,html,css,yml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,md,html,css,yml}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.scripts.json",
    "clean": "node scripts/clean.js",
    "rebuild": "npm run clean && npm run build",
    "size-report": "node scripts/size-report.js",
    "generate:images": "node scripts/generate-images.js",
    "generate:rings": "node scripts/generate-rings.js",
    "apply-vignette": "node scripts/apply-vignette.js",
    "audit:security": "node scripts/security-audit.js",
    "audit:performance": "node scripts/performance-budget.js",
    "audit:all": "npm run audit:security && npm run audit:performance",
    "test:lint": "npm run lint",
    "test:unit": "jest --coverage",
    "test:unit:fast": "jest --maxWorkers=2 --bail",
    "test:unit:watch": "jest --watch",
    "test:unit:ci": "jest --coverage --ci --maxWorkers=2",
    "test:mutation": "stryker run && node --input-type=module -e \"import('node:fs').then(({rmSync})=>rmSync('stryker-tmp',{recursive:true,force:true})).catch(()=>{})\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ci": "playwright test --workers=1",
    "test:accessibility": "playwright test tests/e2e/accessibility.spec.js",
    "test:visual": "playwright test tests/e2e/visual.spec.js",
    "test:visual:update": "playwright test tests/e2e/visual.spec.js --update-snapshots",
    "test:mobile": "playwright test tests/e2e/mobile.spec.js",
    "test:mobile:headed": "playwright test tests/e2e/mobile.spec.js --headed",
    "serve": "node scripts/dev-server.js",
    "audit:lighthouse": "node scripts/lighthouse.js",
    "audit:lighthouse:mobile": "node scripts/lighthouse.js --mobile",
    "audit:lighthouse:desktop": "node scripts/lighthouse.js --desktop",
    "test": "npm run test:unit && npm run test:lint",
    "test:fast": "npm run test:unit:fast && npm run lint:parallel",
    "test:all": "npm run test:unit && npm run test:lint && npm run test:e2e:ci",
    "test:ci": "npm run test:unit:ci && npm run lint:parallel && npm run test:e2e:ci",
    "validate": "node scripts/validate.js",
    "validate:lighthouse": "node scripts/validate.js --lighthouse",
    "check": "npm run clean && npm run test:fast",
    "prod": "npm run build && npm run test:all",
    "ci": "npm run build && npm run test:ci",
    "prepare": "husky"
  },
  "keywords": [
    "medieval",
    "fantasy",
    "guild",
    "ultima-online",
    "single-page-application"
  ],
  "author": "La Compagnia della Ghironda",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "lint-staged": {
    "index.html": "htmlhint --config .htmlhintrc",
    "css/**/*.css": "stylelint --fix",
    "*.{js,cjs,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml}": "prettier --write"
  },
  "devDependencies": {
    "@babel/preset-env": "~7.29.2",
    "@commitlint/config-conventional": "~20.5.0",
    "@eslint/js": "~10.0.1",
    "@playwright/test": "~1.59.1",
    "@stryker-mutator/core": "~9.6.1",
    "@stryker-mutator/jest-runner": "~9.6.1",
    "@types/node": "~25.6.0",
    "axe-playwright": "~2.2.2",
    "babel-jest": "~30.3.0",
    "commitlint": "~20.5.2",
    "cross-env": "10.1.0",
    "esbuild": "~0.28.0",
    "eslint": "~10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jest": "~29.15.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-playwright": "~2.10.4",
    "eslint-plugin-promise": "~7.3.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unicorn": "~66.0.0",
    "htmlhint": "~1.9.2",
    "http-server": "~14.1.1",
    "husky": "~9.1.7",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "lighthouse": "~13.1.0",
    "lint-staged": "~16.4.0",
    "npm-run-all": "~4.1.5",
    "prettier": "3.8.4",
    "sharp": "~0.34.5",
    "stylelint": "~17.9.0",
    "stylelint-config-standard": "~40.0.0",
    "subset-font": "~2.5.0",
    "ttf2woff2": "~8.0.1",
    "typescript": "6.0.3"
  }
}
