# npm Configuration
# Ottimizzazioni per la pipeline di build

# Usa latest npm, minor version per sicurezza
save-prefix=~

# Log verbosity (ridotto)
loglevel=warn

# Usa lock file
package-lock=true

# Timeout per i download (rete veloce)
fetch-timeout=20000

# Non fissare versioni esatte di default
save-exact=false

# Maxsockets per parallelizzare i download
maxsockets=10

# Blocca installazione su versioni Node non supportate (rispecchia "engines" in package.json)
engine-strict=true

# Blocca dipendenze con vulnerabilità moderate, high o critical.
# Allineato a `scripts/security-audit.js` e `SECURITY.md`. Bumping a `low`
# è preferibile a livello assoluto ma genera rumore continuo da advisory
# transitive su versioni patched-but-not-yet-released — `moderate` è la
# soglia che bilancia rigore e signal-to-noise per un sito statico.
audit-level=moderate
